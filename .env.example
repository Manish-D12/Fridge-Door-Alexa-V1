# Copy to server/.env (npm scripts in /server load it automatically).

# --- HTTP -------------------------------------------------------------------
PORT=3000
# 127.0.0.1 enables DNS-rebinding protection automatically. When binding to
# 0.0.0.0 (e.g. in a container), set ALLOWED_HOSTS to your public hostname(s).
HOST=127.0.0.1
# ALLOWED_HOSTS=fridge-door.example.com,localhost
# Browser origins allowed to call /api and /mcp (the web simulator, Inspector direct mode).
# CORS_ORIGINS=http://localhost:5173
# If set (16+ chars), /mcp and /api require "Authorization: Bearer <API_KEY>".
# API_KEY=

# --- Storage ----------------------------------------------------------------
# "local" = JSON file, no AWS needed. "dynamodb" = DynamoDB (default).
STORAGE=local
# LOCAL_DATA_FILE=./.data/obligations.json

DYNAMODB_TABLE=fridge-door-obligations
AWS_REGION=us-east-1
# For DynamoDB Local: http://localhost:8000
# DYNAMODB_ENDPOINT=
# Credentials come from the standard AWS chain (env vars, ~/.aws, SSO, IAM role).
# AWS_PROFILE=

# --- Household --------------------------------------------------------------
# Used when a request has no X-Household-Id header.
DEFAULT_HOUSEHOLD_ID=demo-household
# "Today" and "tomorrow" are computed in this IANA time zone.
HOUSEHOLD_TIMEZONE=America/Los_Angeles
DEFAULT_CURRENCY=USD

# --- Extraction (ingest_text / ingest_image) -------------------------------
# "gemini" (default) or "bedrock". Without the provider's settings the server
# still starts; the ingest tools then say extraction isn't set up.
LLM_PROVIDER=gemini
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# On a 429 / quota error, each of these is tried once, in order (comma-separated).
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
# Model answers are cached here by content hash, so the same document never
# calls the model twice. Delete the folder to clear it.
# EXTRACTION_CACHE_DIR=./.data/extraction-cache
# Bedrock (Converse API) model or inference profile id. Uses AWS_REGION above and
# the standard AWS credential chain.
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# debug | info | warn | error
LOG_LEVEL=info
